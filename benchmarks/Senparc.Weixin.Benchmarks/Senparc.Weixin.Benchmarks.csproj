<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.1</Version>
    <PackageReleaseNotes>
      [2026-07-29] v1.0.0 新增微信 SDK 脱敏与并发注册性能基准及性能门禁
      1、测量日志脱敏截断和并发注册的耗时与分配规模
      2、提供可用于离线质量检查的性能阈值门禁
      [2026-07-31] v1.0.1 Dependency update from Senparc.Weixin to 6.25.1
    </PackageReleaseNotes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Senparc.Weixin/Senparc.Weixin/Senparc.Weixin.net10.csproj"
                      AdditionalProperties="TargetFrameworks=net10.0" />
  </ItemGroup>
</Project>
